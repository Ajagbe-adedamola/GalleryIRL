# --- Basemap ---------------------------------------------------------------
# Satellite provider. One of: maptiler | esri | stadia | protomaps
# Defaults to "maptiler" when NEXT_PUBLIC_MAPTILER_KEY is set, otherwise "esri".
NEXT_PUBLIC_BASEMAP_PROVIDER=maptiler

# MapTiler key (satellite default). https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=

# Stadia Maps key (optional satellite alternative). https://stadiamaps.com/
NEXT_PUBLIC_STADIA_KEY=

# Protomaps API key (optional dark vector basemap). https://protomaps.com/
NEXT_PUBLIC_PROTOMAPS_KEY=

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Moderation ------------------------------------------------------------
# Comma separated allowlist of admin emails (Supabase Auth users).
ADMIN_EMAILS=you@example.com
